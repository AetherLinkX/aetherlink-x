+    private async addAetherLinkXUser(data: {
+        tag: string;
+        username: string;
+        uuid: string;
+        secret: string;
+    }): Promise<ISdkResponse<AddUserResponseModelFromSdk>> {
+        try {
+            const client = createClient(HandlerServiceDefinition, this.xtlsApi.channel);
+            await client.alterInbound({
+                tag: data.tag,
+                operation: createTypedMessage(AddUserOperation, {
+                    user: User.create({
+                        email: data.username,
+                        level: 0,
+                        account: createAetherLinkXAccount(data.uuid, data.secret),
+                    }),
+                }),
+            });
+
+            return {
+                isOk: true,
+                data: new AddUserResponseModelFromSdk(true),
+            };
+        } catch (error) {
+            const message = error instanceof Error ? error.message : String(error);
+            if (message.includes('already exists')) {
+                return {
+                    isOk: true,
+                    data: new AddUserResponseModelFromSdk(false),
+                };
+            }
+            return {
+                isOk: false,
+                message,
+            };
+        }
+    }
 }
