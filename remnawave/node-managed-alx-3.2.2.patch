new file mode 100644
index 0000000..3355125
--- /dev/null
+++ b/src/modules/handler/aetherlinkx-account.ts
@@ -0,0 +1,46 @@
+import { createHash } from 'node:crypto';
+
+import { TypedMessage } from '@remnawave/xtls-sdk/build/src/xray-protos/common/serial/typed_message';
+
+const ACCOUNT_TYPE = 'xray.proxy.aetherlinkx.Account';
+const KDF_CONTEXT = 'AetherLink X Remnawave user secret v1\u0000';
+
+function encodeVarint(value: number): number[] {
+    const result: number[] = [];
+    let remaining = value >>> 0;
+    while (remaining >= 0x80) {
+        result.push((remaining & 0x7f) | 0x80);
+        remaining >>>= 7;
+    }
+    result.push(remaining);
+    return result;
+}
+
+function encodeStringField(fieldNumber: number, value: string): Uint8Array {
+    const body = Buffer.from(value, 'utf8');
+    return Uint8Array.from([
+        ...encodeVarint((fieldNumber << 3) | 2),
+        ...encodeVarint(body.length),
+        ...body,
+    ]);
+}
+
+export function deriveAetherLinkXSecret(ssPassword: string): string {
+    return createHash('sha256')
+        .update(KDF_CONTEXT, 'utf8')
+        .update(ssPassword, 'utf8')
+        .digest('base64url');
+}
+
+export function createAetherLinkXAccount(id: string, secret: string): TypedMessage {
+    const idField = encodeStringField(1, id);
+    const secretField = encodeStringField(2, secret);
+    const value = new Uint8Array(idField.length + secretField.length);
+    value.set(idField, 0);
+    value.set(secretField, idField.length);
+
+    return TypedMessage.create({
+        type: ACCOUNT_TYPE,
+        value,
+    });
+}
