+    private buildAetherLinkLink(
+        host: Extract<ResolvedProxyConfig, { protocol: 'aetherlink' }>,
+    ): string {
+        const params = new URLSearchParams({
+            pin: host.protocolOptions.pin,
+            sni: host.protocolOptions.sni,
+            mode: host.protocolOptions.mode,
+            // The native client expects the TCP recovery port here, not the
+            // server-side transport policy (auto/quic/tcp). ALX exposes QUIC
+            // and Turbo/TCP on the same Host port.
+            fallback: String(host.port),
+        });
+        const token = encodeURIComponent(host.protocolOptions.token);
+        const remark = encodeURIComponent(host.finalRemark);
+        return `aetherlink://${token}@${host.address}:${host.port}?${params.toString()}#${remark}`;
+    }
