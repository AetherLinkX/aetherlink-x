+func validateInboundTransportSecurity(rawConfig interface{}, receiverSettings *proxyman.ReceiverConfig) error {
+	alxCfg, ok := rawConfig.(*AetherLinkXServerConfig)
+	if !ok || alxCfg.AllowInsecureTransport {
+		return nil
+	}
+	if receiverSettings.StreamSettings != nil && receiverSettings.StreamSettings.GetSecurityType() != "" {
+		return nil
+	}
+	return errors.New("AetherLink X inbound requires TLS or REALITY; use allowInsecureTransport only on isolated private/test networks")
+}
+
+func applyAetherLinkXTransportTuning(turbo *AetherLinkXTurboConfig, streamSettings **internet.StreamConfig) {
+	if turbo == nil || !turbo.Enabled {
+		return
+	}
+	if *streamSettings == nil {
+		*streamSettings = &internet.StreamConfig{ProtocolName: "tcp"}
+	}
+	stream := *streamSettings
+	if stream.SocketSettings == nil {
+		stream.SocketSettings = new(internet.SocketConfig)
+	}
+	socket := stream.SocketSettings
+	if socket.TcpKeepAliveIdle == 0 {
+		socket.TcpKeepAliveIdle = turbo.TCPKeepAliveIdle
+		if socket.TcpKeepAliveIdle == 0 {
+			socket.TcpKeepAliveIdle = 15
+		}
+	}
+	if socket.TcpKeepAliveInterval == 0 {
+		socket.TcpKeepAliveInterval = turbo.TCPKeepAliveInterval
+		if socket.TcpKeepAliveInterval == 0 {
+			socket.TcpKeepAliveInterval = 5
+		}
+	}
+	if socket.TcpUserTimeout == 0 {
+		socket.TcpUserTimeout = turbo.TCPUserTimeout
+		if socket.TcpUserTimeout == 0 {
+			socket.TcpUserTimeout = 10000
+		}
+	}
+	if socket.TcpCongestion == "" && turbo.Congestion != "" && !strings.EqualFold(turbo.Congestion, "auto") {
+		socket.TcpCongestion = strings.ToLower(turbo.Congestion)
+	}
+	if turbo.MultipathTCP {
+		socket.TcpMptcp = true
+	}
+}
+
+func applyAetherLinkXMuxTuning(turbo *AetherLinkXTurboConfig, sender *proxyman.SenderConfig) {
+	if turbo == nil || !turbo.Enabled || turbo.MuxConcurrency <= 0 || sender.MultiplexSettings != nil {
+		return
+	}
+	xudpPolicy := strings.ToLower(strings.TrimSpace(turbo.XUDPProxyUDP443))
+	if xudpPolicy == "" {
+		xudpPolicy = "reject"
+	}
+	sender.MultiplexSettings = &proxyman.MultiplexingConfig{
+		Enabled:         true,
+		Concurrency:     turbo.MuxConcurrency,
+		XudpConcurrency: turbo.XUDPConcurrency,
+		XudpProxyUDP443: xudpPolicy,
+	}
+}
