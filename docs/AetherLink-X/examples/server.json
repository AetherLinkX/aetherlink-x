{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "aetherlinkx-in",
      "listen": "0.0.0.0",
      "port": 443,
      "protocol": "aetherlinkx",
      "settings": {
        "users": [
          {
            "id": "018f3f89-01be-7b44-8a7f-23e54f92ea00",
            "secret": "REPLACE_WITH_SAME_32_BYTE_BASE64URL_SECRET",
            "email": "player@example.com",
            "level": 0,
            "policy": "turbo"
          }
        ],
        "securityProfile": "transport-bound",
        "handshakeTimeoutSeconds": 4,
        "maxClientInitBytes": 4096,
        "maxFrameBytes": 16384,
        "replayCacheSeconds": 180,
        "turbo": {
          "enabled": true,
          "targetQueueMs": 4,
          "maxQueueMs": 12,
          "maxDatagramAgeMs": 35,
          "maxRealtimeStreamsPerUser": 32,
          "maxLanesPerUser": 2,
          "streamIsolation": true
        },
        "accelerator": {
          "headerCompression": true,
          "destinationCacheSize": 64,
          "payloadCompression": false
        },
        "multipath": {
          "enabled": true,
          "maxPathsPerSession": 2,
          "pathValidation": "hmac-token"
        }
      },
      "streamSettings": {
        "method": "raw",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "target": "www.example.com:443",
          "xver": 0,
          "serverNames": [
            "www.example.com"
          ],
          "privateKey": "REPLACE_WITH_REALITY_PRIVATE_KEY",
          "minClientVer": "26.3.27",
          "maxTimeDiff": 0,
          "shortIds": [
            "0123456789abcdef"
          ]
        },
        "sockopt": {
          "tcpKeepAliveIdle": 30,
          "tcpKeepAliveInterval": 10,
          "tcpUserTimeout": 10000
        }
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {}
    },
    {
      "tag": "block",
      "protocol": "blackhole",
      "settings": {}
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "type": "field",
        "inboundTag": [
          "aetherlinkx-in"
        ],
        "outboundTag": "direct"
      }
    ]
  }
}

